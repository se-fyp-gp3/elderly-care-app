classDiagram
    class Elderly {
        +string user_id
        +string name
        +string phone
        +Date birth
        +ElderlyStatus status
        +getProfile()
        +updateStatus()
    }

    class ElderlyMedication {
        +string elderly_id
        +string name
        +string dosage
        +string frequency
        +Status status
        +markAsTaken()
        +getReminders()
    }

    class MedicationLog {
        +string log_id
        +DateTime taken_at
        +string status
        +createLog()
    }

    class Schedule {
        +string title
        +DateTime time
        +string description
        +fetchUpcoming()
    }

    Elderly "1" o-- "*" ElderlyMedication : has
    ElderlyMedication "1" *-- "*" MedicationLog : logs
    Elderly "1" o-- "*" Schedule : has
