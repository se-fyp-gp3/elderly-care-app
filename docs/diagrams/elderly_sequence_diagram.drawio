<mxfile host="app.diagrams.net">
  <diagram name="Elderly Sequence Diagram" id="elderly-sequence-diagram">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Lifelines -->
        <mxCell id="elderly" value="Elderly User" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="100" height="400" as="geometry" />
        </mxCell>
        <mxCell id="uiapp" value="Mobile App UI" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="100" height="400" as="geometry" />
        </mxCell>
        <mxCell id="controller" value="Medication Controller" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="140" height="400" as="geometry" />
        </mxCell>
        <mxCell id="database" value="Appwrite DB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="100" height="400" as="geometry" />
        </mxCell>

        <!-- Messages -->
        <!-- 1. Open Screen -->
        <mxCell id="msg1" value="Open Medication Screen" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="elderly" target="uiapp">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="100" as="sourcePoint" />
            <mxPoint x="290" y="100" as="targetPoint" />
            <Array as="points">
              <mxPoint x="200" y="100" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 2. Fetch Data -->
        <mxCell id="msg2" value="fetchActiveMedicationReminders()" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="uiapp" target="controller">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="130" as="sourcePoint" />
            <mxPoint x="470" y="130" as="targetPoint" />
            <Array as="points">
              <mxPoint x="360" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg3" value="listRows(Medications)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="controller" target="database">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="160" as="sourcePoint" />
            <mxPoint x="650" y="160" as="targetPoint" />
            <Array as="points">
              <mxPoint x="540" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg4" value="Return Data" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;" edge="1" parent="1" source="database" target="uiapp">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="190" as="sourcePoint" />
            <mxPoint x="290" y="190" as="targetPoint" />
            <Array as="points">
              <mxPoint x="470" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 3. Take Meds -->
        <mxCell id="msg5" value="Click 'Take' Button" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="elderly" target="uiapp">
          <mxGeometry y="220" relative="1" as="geometry">
            <mxPoint x="130" y="220" as="sourcePoint" />
            <mxPoint x="290" y="220" as="targetPoint" />
            <Array as="points">
              <mxPoint x="200" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg6" value="logMedicationAction(id, 'taken')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="uiapp" target="controller">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="250" as="sourcePoint" />
            <mxPoint x="470" y="250" as="targetPoint" />
            <Array as="points">
              <mxPoint x="360" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg7" value="createRow(MedicationLog)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="controller" target="database">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="280" as="sourcePoint" />
            <mxPoint x="650" y="280" as="targetPoint" />
            <Array as="points">
              <mxPoint x="540" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg8" value="Success" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;" edge="1" parent="1" source="database" target="controller">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="310" as="sourcePoint" />
            <mxPoint x="470" y="310" as="targetPoint" />
            <Array as="points">
              <mxPoint x="540" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg9" value="Update UI to 'Completed'" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;" edge="1" parent="1" source="controller" target="uiapp">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="340" as="sourcePoint" />
            <mxPoint x="290" y="340" as="targetPoint" />
            <Array as="points">
              <mxPoint x="360" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>