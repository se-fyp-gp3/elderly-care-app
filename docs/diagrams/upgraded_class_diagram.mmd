classDiagram
    direction LR

    %% ---------------------------------------------------------
    %% User Domain
    %% ---------------------------------------------------------
    class Elderly {
        +String user_id
        +String name
        +String phone
        +String birth
        +ElderlyStatus status
        +createElderlyProfile(data: Elderly)
        +getElderlyByUserId(userId: String)
        +getTodayKey()
    }
    class Caregiver {
        +String user_id
        +String name
        +String phone
        +String birth
        +createCaregiverProfile(data: Caregiver)
        +getCaregiverByUserId(userId: String)
    }

    %% Association table for Many-to-Many
    class CaregiverElderly {
        +Caregiver[] caregiver
        +Elderly[] elderly
    }

    Caregiver "1" -- "0..*" CaregiverElderly
    Elderly "1" -- "0..*" CaregiverElderly


    %% ---------------------------------------------------------
    %% Medication Domain
    %% ---------------------------------------------------------
    class Medication {
        +String name
        +String unit
    }

    class ElderlyMedication {
        +Elderly elderly
        +Medication medication
        +Number dosage
        +String frequency
        +Boolean is_prn
        +Number times_per_day
        +String[] approx_times
        +ElderlyMedicationStatus status
        +String last_taken
        +String notes
        +fetchElderlyMedicationsForUser(userId: String)
    }

    class ElderlyMedicationReminder {
        +Elderly elderly
        +ElderlyMedication elderly_medication
        +String start_date
        +Number duration_days
        +Boolean after_meal
        +String[] reminder_times
        +Boolean active
        +Boolean is_finished
        +checkAndMarkSkippedMedications(userId: String)
    }

    class MedicationLog {
        +ElderlyMedicationReminder elderly_medication_reminder
        +Elderly elderly
        +DateTime scheduled_at
        +DateTime taken_at
        +String status
        +String notes
    }

    Medication "1" -- "0..*" ElderlyMedication : defines
    Elderly "1" -- "0..*" ElderlyMedication : takes
    ElderlyMedication "1" -- "0..1" ElderlyMedicationReminder : schedules
    ElderlyMedicationReminder "1" -- "0..*" MedicationLog : generates
    Elderly "1" -- "0..*" MedicationLog : tracks


    %% ---------------------------------------------------------
    %% Schedule Domain
    %% ---------------------------------------------------------
    class ScheduleCategory {
        +String name
        +String color_hex
        +String svg_icon
    }

    class Schedule {
        +Elderly elderly
        +ScheduleCategory schedule_category
        +DateTime time
        +String title
        +String description
        +ScheduleStatus status
    }

    Elderly "1" -- "0..*" Schedule : owns
    ScheduleCategory "1" -- "0..*" Schedule : categorizes


    %% ---------------------------------------------------------
    %% Health & Emergency Domain
    %% ---------------------------------------------------------
    class HealthData {
        +Elderly elderly
        +DateTime time
        +String type
        %% Value field implied in implementation
        +String value 
    }

    class EmergencyContact {
        %% Currently defined in UI implementation
        +String id
        +String name
        +String relation
        +String phone
        +handleCall()
        +handleEmergencyCall()
    }

    Elderly "1" -- "0..*" HealthData : records
    Elderly "1" .. "0..*" EmergencyContact : views (UI)


    %% ---------------------------------------------------------
    %% Chat System
    %% ---------------------------------------------------------
    class ChatSessionRow {
        +String user_id
        +String chat_id
        +String title
        +String messages
        +DateTime updated_at
        +createChatSession(input: ChatSessionInput)
        +listChatSessionsForUser(userId: String)
        +deleteChatSession(rowId: String)
    }

    Elderly "1" -- "0..*" ChatSessionRow : participates
