<mxfile host="app.diagrams.net">
  <diagram name="Detailed Sequence Diagrams" id="detailed-sequence-diagrams">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start_instruction" value="&lt;h1&gt;Mermaid Sequence Diagram Source&lt;/h1&gt;&lt;p&gt;Copy the code blocks below to generate diagrams via Insert &amp;gt; Advanced &amp;gt; Mermaid...&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
            <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- Diagram 1: Auth -->
        <mxCell id="auth_block" value="&lt;h3&gt;1. Authentication Sequence&lt;/h3&gt;&lt;pre&gt;sequenceDiagram&#xa;    autonumber&#xa;    actor Elder as Elderly User&#xa;    participant UI as Mobile App (Register Screen)&#xa;    participant Auth as Auth Context &amp;amp; API&#xa;    participant UserDB as Appwrite DB &lt;br/&gt;(Users/Elderly)&#xa;    &#xa;    Elder-&gt;&gt;UI: Select &quot;Sign Up&quot;&#xa;    UI-&gt;&gt;Elder: Display Identity Selection&#xa;    Elder-&gt;&gt;UI: Choose &quot;Elderly&quot;&#xa;    UI-&gt;&gt;Elder: Display Register Form&#xa;    Elder-&gt;&gt;UI: Input Email, Password, Name&#xa;    Elder-&gt;&gt;UI: Click &quot;Create Account&quot;&#xa;    &#xa;    UI-&gt;&gt;Auth: account.create(ID.unique(), email, password, name)&#xa;    &#xa;    alt Account Creation Success&#xa;        Auth--&gt;&gt;UI: User Account Object&#xa;        UI-&gt;&gt;Auth: account.createEmailPasswordSession(email, password)&#xa;        Auth--&gt;&gt;UI: Session Token (Active)&#xa;        &#xa;        Note over UI, UserDB: Need to create Elder-specific profile&#xa;        &#xa;        UI-&gt;&gt;UserDB: createElderlyProfile(userId, name, phone, etc.)&#xa;        UserDB--&gt;&gt;UI: Success (Elderly Document)&#xa;        &#xa;        UI-&gt;&gt;Auth: fetchUserPreferences()&#xa;        Auth--&gt;&gt;UI: Preferences { role: &quot;elderly&quot; }&#xa;        UI-&gt;&gt;Elder: Navigate to Elderly Dashboard&#xa;    else Account Exists / Error&#xa;        Auth--&gt;&gt;UI: Error (409 Conflict)&#xa;        UI-&gt;&gt;Elder: Show &quot;Email already in use&quot;&#xa;    end&lt;/pre&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;overflow=hidden;rounded=0;strokeColor=#d6b656;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="400" height="500" as="geometry" />
        </mxCell>

        <!-- Diagram 2: Chat -->
        <mxCell id="chat_block" value="&lt;h3&gt;2. Chat Sequence&lt;/h3&gt;&lt;pre&gt;sequenceDiagram&#xa;    autonumber&#xa;    actor Elder as Elderly User&#xa;    participant UI as Chat Screen&#xa;    participant ChatMgr as Chat Service&#xa;    participant AI as OpenRouter AI API&#xa;    participant DB as Appwrite DB (Chat History)&#xa;&#xa;    Elder-&gt;&gt;UI: Open Chat Tab&#xa;    UI-&gt;&gt;DB: listChatSessionsForUser(userId)&#xa;    DB--&gt;&gt;UI: List of ChatSessions&#xa;    UI-&gt;&gt;Elder: Render History &amp;amp; Input&#xa;    &#xa;    Elder-&gt;&gt;UI: Type message and click Send&#xa;    UI-&gt;&gt;UI: Add immediate optimistic user message&#xa;    &#xa;    UI-&gt;&gt;AI: POST /api/v1/chat/completions (model, messages[])&#xa;    activate AI&#xa;    &#xa;    loop Stream Response&#xa;        AI--&gt;&gt;UI: Chunk of text data&#xa;        UI-&gt;&gt;UI: Update Assistant message state&#xa;    end&#xa;    &#xa;    AI--&gt;&gt;UI: Stream Complete&#xa;    deactivate AI&#xa;    &#xa;    Note right of UI: Save conversation to DB&#xa;    &#xa;    UI-&gt;&gt;ChatMgr: updateChatSession(chatId, newMessages)&#xa;    alt New Session&#xa;        ChatMgr-&gt;&gt;DB: createChatSession(...)&#xa;    else Existing Session&#xa;        ChatMgr-&gt;&gt;DB: updateRow(chatId, messages)&#xa;    end&#xa;    DB--&gt;&gt;ChatMgr: Success&#xa;    ChatMgr--&gt;&gt;UI: Saved&lt;/pre&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;overflow=hidden;rounded=0;strokeColor=#82b366;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="460" y="80" width="400" height="500" as="geometry" />
        </mxCell>

         <!-- Diagram 3: Meds -->
        <mxCell id="med_block" value="&lt;h3&gt;3. Add Medication Sequence&lt;/h3&gt;&lt;pre&gt;sequenceDiagram&#xa;    autonumber&#xa;    actor Elder as Elderly User&#xa;    participant UI as Medication Screen&#xa;    participant Lib as lib/medication_tracking&#xa;    participant DB as Appwrite DB&#xa;    participant Notif as Notifications (Expo)&#xa;&#xa;    Elder-&gt;&gt;UI: Tap (+) Add Medication&#xa;    UI-&gt;&gt;Elder: Show Form (Name, Dosage, Time)&#xa;    Elder-&gt;&gt;UI: Fill details and &quot;Save&quot;&#xa;    &#xa;    UI-&gt;&gt;Lib: createElderlyMedicationWithReminder(data)&#xa;    &#xa;    rect rgb(240, 248, 255)&#xa;        Note right of Lib: Transaction-like operation&#xa;        Lib-&gt;&gt;DB: createRow(ElderlyMedication)&#xa;        DB--&gt;&gt;Lib: Medication ID&#xa;        &#xa;        Lib-&gt;&gt;DB: createRow(ElderlyMedicationReminder)&#xa;        DB--&gt;&gt;Lib: Reminder ID&#xa;    end&#xa;    &#xa;    Lib--&gt;&gt;UI: Success&#xa;    &#xa;    UI-&gt;&gt;Notif: scheduleMedicationNotification(title, time)&#xa;    Notif-&gt;&gt;Notif: Validates permission&#xa;    Notif-&gt;&gt;Notif: Schedule local notification&#xa;    &#xa;    UI-&gt;&gt;Elder: Show Success Message&#xa;    UI-&gt;&gt;UI: Refresh List&#xa;    &#xa;    opt Daily Check Logic (On Screen Load)&#xa;        UI-&gt;&gt;Lib: checkAndMarkSkippedMedications(userId)&#xa;        Lib-&gt;&gt;DB: Fetch Active Reminders&#xa;        Lib-&gt;&gt;DB: Fetch Today's Logs&#xa;        Lib-&gt;&gt;Lib: Compare Time vs Now (Buffer 1min)&#xa;        alt Found Missed Meds&#xa;            Lib-&gt;&gt;DB: updateRow(Log, status='missing')&#xa;        end&#xa;    end&lt;/pre&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;overflow=hidden;rounded=0;strokeColor=#b85450;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="400" height="600" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>