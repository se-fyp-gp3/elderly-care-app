<mxfile host="app.diagrams.net">
  <diagram name="Additional State Diagrams" id="additional-state-diagrams">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="instruction_text" value="&lt;h1&gt;Mermaid Diagram Source&lt;/h1&gt;&lt;p&gt;To render this diagram:&lt;/p&gt;&lt;ol&gt;&lt;li&gt;Select &lt;strong&gt;Arrange &amp;gt; Insert &amp;gt; Advanced &amp;gt; Mermaid...&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;Copy the code below and paste it into the dialog.&lt;/li&gt;&lt;/ol&gt;&lt;pre&gt;stateDiagram-v2&#xa;    direction LR&#xa;&#xa;    %% ============================================================&#xa;    %% 1. User Authentication &amp;amp; Session State (UC-01, UC-02)&#xa;    %% ============================================================&#xa;    state &quot;User Session Lifecycle&quot; as AuthState {&#xa;        [*] --&amp;gt; Unauthenticated&#xa;        &#xa;        Unauthenticated --&amp;gt; LoginView : Launch App&#xa;        Unauthenticated --&amp;gt; RegisterView : Select &quot;Sign Up&quot;&#xa;&#xa;        state LoginView {&#xa;            [*] --&amp;gt; EnteringCredentials&#xa;            EnteringCredentials --&amp;gt; Validating : Submit&#xa;            Validating --&amp;gt; Error : Invalid Creds&#xa;            Error --&amp;gt; EnteringCredentials : Retry&#xa;        }&#xa;&#xa;        state RegisterView {&#xa;            [*] --&amp;gt; IdentitySelection&#xa;            IdentitySelection --&amp;gt; InputDetails : Elderly/Caregiver Selected&#xa;            InputDetails --&amp;gt; CreatingAccount : Submit&#xa;            CreatingAccount --&amp;gt; ProfileSetup : Account Created&#xa;            ProfileSetup --&amp;gt; SavingProfile : Save Details&#xa;        }&#xa;&#xa;        Validating --&amp;gt; Authenticated : Success&#xa;        SavingProfile --&amp;gt; Authenticated : Success&#xa;&#xa;        state Authenticated {&#xa;            [*] --&amp;gt; Routing&#xa;            Routing --&amp;gt; ElderlyDashboard : Role = Elderly&#xa;            Routing --&amp;gt; CaregiverDashboard : Role = Caregiver&#xa;        }&#xa;&#xa;        Authenticated --&amp;gt; Unauthenticated : Log Out&#xa;    }&#xa;&#xa;    %% ============================================================&#xa;    %% 2. Chat Interaction State (UC-06)&#xa;    %% ============================================================&#xa;    state &quot;Chat Interaction&quot; as ChatState {&#xa;        [*] --&amp;gt; Idle&#xa;&#xa;        Idle --&amp;gt; Sending : User sends message&#xa;        &#xa;        state Sending {&#xa;            [*] --&amp;gt; Uploading&#xa;            Uploading --&amp;gt; ServerReceived&#xa;        }&#xa;&#xa;        Sending --&amp;gt; AIProcessing : Success&#xa;        &#xa;        state AIProcessing {&#xa;            [*] --&amp;gt; AnalyzingContext&#xa;            AnalyzingContext --&amp;gt; GeneratingResponse&#xa;        }&#xa;&#xa;        AIProcessing --&amp;gt; StreamingResponse : AI Ready&#xa;        &#xa;        state StreamingResponse {&#xa;            [*] --&amp;gt; ReceivingChunks&#xa;            ReceivingChunks --&amp;gt; Finalizing&#xa;        }&#xa;&#xa;        StreamingResponse --&amp;gt; Idle : Complete&#xa;        StreamingResponse --&amp;gt; Error : Connection Lost&#xa;        Sending --&amp;gt; Error : Network Fail&#xa;        &#xa;        Error --&amp;gt; Idle : Retry/Dismiss&#xa;    }&#xa;&#xa;    %% ============================================================&#xa;    %% 3. Emergency Trigger State (UC-05)&#xa;    %% ============================================================&#xa;    state &quot;Emergency Flow&quot; as EmergencyState {&#xa;        [*] --&amp;gt; NormalState&#xa;&#xa;        NormalState --&amp;gt; ConfirmationDialog : Tap SOS Button&#xa;        &#xa;        state ConfirmationDialog {&#xa;            [*] --&amp;gt; WaitingForInput&#xa;            WaitingForInput --&amp;gt; Cancelled : Tap &quot;Cancel&quot;&#xa;            WaitingForInput --&amp;gt; Confirmed : Tap &quot;Call 999&quot;&#xa;            WaitingForInput --&amp;gt; Confirmed : Timeout (if auto-trigger)&#xa;        }&#xa;&#xa;        ConfirmationDialog --&amp;gt; NormalState : Cancelled&#xa;        Confirmed --&amp;gt; LaunchingDialer&#xa;&#xa;        state LaunchingDialer {&#xa;            [*] --&amp;gt; InvokingNativeOS&#xa;            InvokingNativeOS --&amp;gt; CallActive : User presses call in OS&#xa;        }&#xa;&#xa;        CallActive --&amp;gt; NormalState : End Call&#xa;    }&#xa;&lt;/pre&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="600" height="800" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>